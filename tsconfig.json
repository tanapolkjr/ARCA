{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] }
  },
  "include": [
    "src/features/sourcing",
    "src/features/accounting",
    "src/features/cashbook",
    "src/accounting-lib",
    "src/accounting-api",
    "src/sourcing-lib",
    "src/sourcing-api",
    "src/components/sourcing-ui",
    "src/hooks/useSourcingQuery.ts",
    "src/hooks/platform-hooks.d.ts",
    "src/vite-env.d.ts"
  ]
}
